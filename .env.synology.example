# Copie este arquivo para .env na pasta do projeto no NAS
# (ex.: /volume1/docker/planeradar/.env) e ajuste os valores.
# O .env nunca deve ser versionado no git.

# Porta local onde o container escuta. O reverse proxy HTTPS do DSM aponta para ela.
HTTP_PORT=5000

# Pasta do host montada em /data (cache SQLite). Deve ser de propriedade 1030:65536.
DATA_DIR=./data

# Localização do radar (latitude e longitude em graus decimais).
PLANE_RADAR_LAT=-21.805684
PLANE_RADAR_LON=-48.139653

# Raio de busca em milhas náuticas (até 250).
PLANE_RADAR_DISTANCE=25

# Intervalo de atualização em segundos (inteiro, mínimo 3).
PLANE_RADAR_POLLING=10

# Quantos proxies reversos confiáveis ficam na frente do app (padrão 1: reverse proxy do DSM).
# Use 0 para ignorar os cabeçalhos X-Forwarded-* (acesso direto, sem proxy).
PLANE_RADAR_TRUSTED_PROXIES=1

# Chave da API de logos de companhias aéreas (opcional).
# Obtenha em https://airline.logostream.dev/pricing. Sem a chave, os logos não são exibidos.
PLANE_RADAR_AIRLINE_LOGO_API_KEY=
